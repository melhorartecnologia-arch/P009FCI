[Unit]
Description=Simulador FCI · Cervejaria Cidade Imperial (Node.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=fci
Group=fci
WorkingDirectory=/opt/simulador-fci
EnvironmentFile=/opt/simulador-fci/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
# Endurecimento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/simulador-fci/dados

[Install]
WantedBy=multi-user.target
