# ============================================================
# Simulador FCI — configuração do ambiente (VPS AWS Ubuntu)
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ============================================================

# Porta HTTP da aplicação Node.js
PORT=3000

# PostgreSQL — mesma instância/VPS da aplicação
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=fci_simulador
PGUSER=fci_app
PGPASSWORD=troque-esta-senha

# Segredos — gere cada um com: openssl rand -hex 32
# FCI_SECRET_KEY cifra as credenciais das integrações (AES-256-GCM · RNF-05)
FCI_SECRET_KEY=
# FCI_JWT_SECRET assina os tokens de sessão
FCI_JWT_SECRET=
# Validade da sessão
FCI_JWT_EXPIRA=12h

# Sincronização agendada das fontes de dados (RF-093)
FCI_SYNC_AGENDADA=true

# Senha inicial dos usuários criados pelo seed (troque após o 1º acesso)
SEED_SENHA=cci@2026
