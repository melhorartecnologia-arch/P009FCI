{
  "name": "simulador-fci",
  "version": "1.0.0",
  "description": "Simulador FCI — Cervejaria Cidade Imperial. Escopo funcional completo: RF-001 a RF-100, RN-01 a RN-12, RNF-01 a RNF-10.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test test/engine.test.js test/api.test.js test/smoke.test.js",
    "test:engine": "node --test test/engine.test.js",
    "test:api": "node --test test/api.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "mssql": "^10.0.2",
    "mysql2": "^3.10.0",
    "oracledb": "^6.5.1"
  }
}